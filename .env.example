# Production values are generated once on the server by
# infrastructure/deployment/bootstrap.sh into /opt/synthcut/shared/.env (chmod 600).
# This file documents every variable; never commit real secrets.

ENV=prod                      # dev | test | prod
LOG_LEVEL=INFO
SYNTHCUT_DOMAIN=synthcut.example.com
PUBLIC_BASE_URL=https://synthcut.example.com

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://synthcut:PASSWORD@postgres:5432/synthcut
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@redis:6379/0

GARAGE_CONFIG=/opt/synthcut/shared/garage.toml
GARAGE_RPC_SECRET=            # 64 hex chars
GARAGE_ADMIN_TOKEN=
S3_ENDPOINT_INTERNAL=http://storage:3900
S3_ENDPOINT_PUBLIC=https://synthcut.example.com   # presigned URLs are signed for this host
S3_REGION=us-east-1
S3_BUCKET=synthcut-media
S3_ACCESS_KEY_ID=             # GK + 24 hex chars
S3_SECRET_ACCESS_KEY=         # 64 hex chars
STORAGE_HARD_LIMIT=30GiB      # enforced by Garage itself

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=      # >= 24 chars
TELEGRAM_BOT_USERNAME=synthcut_bot
AUTHORIZED_TELEGRAM_USER_IDS= # comma separated; empty = nobody (fails closed)
SESSION_SECRET=               # >= 32 chars

MAX_UPLOAD_BYTES=53687091200      # 50 GiB per file
STORAGE_QUOTA_BYTES=26843545600   # 25 GiB total (shared VPS)
DISK_RESERVE_BYTES=8589934592     # keep 8 GiB free for the other services
UPLOAD_PART_SIZE=16777216         # 16 MiB

# Optional: model routing, provider-independent (spec §29). Phase 5+.
# MODEL_ROUTES={"reasoning": ["anthropic:claude-opus-5"]}
# ANTHROPIC_API_KEY=
